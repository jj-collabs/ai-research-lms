# --- Server ---
PORT=3000
NODE_ENV=production
# Long random string used to sign session (JWT) cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
# Comma-separated list of e-mail addresses (or a single admin invite code) allowed
# to self-register as an administrator. Leave blank to disable admin self-registration
# entirely and create the first admin via `npm run seed` instead (recommended).
ADMIN_INVITE_CODE=change_this_invite_code

# --- AI provider (provider-configurable) ---
# Which provider to call: "anthropic", "azure" (Claude via Foundry),
# "azure-openai" (GPT models via Foundry/Azure OpenAI), or "openai"
AI_PROVIDER=anthropic

# Anthropic settings (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Azure / Microsoft Foundry settings (used when AI_PROVIDER=azure)
# Lets you pay for Claude usage out of Azure credit instead of a separate
# Anthropic bill. Get these from your Foundry model deployment page:
#   AZURE_AI_ENDPOINT    = the "Target URI" shown on the deployment
#                           (e.g. https://<resource>.services.ai.azure.com/anthropic/v1/messages)
#   AZURE_AI_API_KEY     = the deployment's key
#   AZURE_AI_MODEL       = your deployment/model name (e.g. claude-haiku-4-5)
#   AZURE_AI_API_VERSION = only needed if your resource requires an api-version
#                           query param; leave blank otherwise
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=
AZURE_AI_API_VERSION=

# Azure OpenAI settings (used when AI_PROVIDER=azure-openai)
# For GPT models (e.g. gpt-5.4-nano) deployed via Foundry's newer unified
# "v1" endpoint. Different from the AZURE_AI_* block above (Claude on Foundry).
#   AZURE_OPENAI_ENDPOINT   = the "Project endpoint" from your deployment's page,
#                             WITH /openai/v1 appended, e.g.:
#                             https://<resource>.services.ai.azure.com/openai/v1
#   AZURE_OPENAI_API_KEY    = the API Key shown on your deployment's page
#   AZURE_OPENAI_DEPLOYMENT = the deployment name you chose (e.g. gpt-5.4-nano)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# OpenAI settings (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Study / ethics ---
# Text shown on the consent screen before a student can register.
STUDY_TITLE="Quantitative analysis of students' AI use"
